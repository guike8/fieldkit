#!/bin/sh
set -eu
fieldkit_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -x "$fieldkit_root/target/release/fieldkit" ]; then
    exec "$fieldkit_root/target/release/fieldkit" "$@"
fi
if command -v cargo >/dev/null 2>&1; then
    exec cargo run --quiet --release --manifest-path "$fieldkit_root/Cargo.toml" -- "$@"
fi
printf '%s\n' 'Build Fieldkit with cargo build --release, then run ./fieldkit tui --case cases/my-investigation.' >&2
exit 1
