  "discovery": {
    "max_depth": 4,
    "max_jobs": 100,
    "max_reasoning_budget": 20,
    "nvidia_unavailable": "Pause visibly; never silently fall back to local ranking",
    "pause": "TUI p stops NVIDIA reasoning promptly or pauses after the active collector; g resumes pending work",
    "persistent_budget": true,
    "planners": [
      "local",
      "nvidia"
    ],
    "seed_kinds": [
      "username",
      "profile",
      "url",
      "domain",
      "search"
    ],
    "strategy": "Explicit observed profiles and links; optional NVIDIA reasoning chooses or proposes cited public collectors; search is opt-in"
  },
  "name": "fieldkit",
  "ontology": {
    "claims": "Preserved report pointers, hashes and source references",
    "model_assessments": "Retained separately from source facts and excluded from future evidence projections",
    "nvidia_semantic_catalog": "Separate normalized read-only SQLite datasource; compiled by the actual NVIDIA service",
    "nvidia_service_integrated": true,
    "provider": "fieldkit_structured_evidence",
    "versioned_vocabulary": true
  },
  "optional_providers": {
    "brave_search": {
      "configured": false,
      "key_environment_variable": "BRAVE_SEARCH_API_KEY"
    }
  },
  "orchestration": {
    "app": "fieldkit --case CASE app --workspace DIRECTORY",
    "batch": "fieldkit --case DIR batch JOBS.jsonl",
    "discovery": "fieldkit --case CASE discover SEED --kind username --jobs 12 --depth 2",
    "mcp": "fieldkit --case CASE mcp --workspace DIRECTORY",
    "ontology": "fieldkit --case CASE ontology --sync",
    "run": "fieldkit --case DIR run JOB.json",
    "tui": "fieldkit tui --case CASE"
  },
