# Private local deployment settings. Copy with setup.sh init; generated secrets
# replace the change-me values. Never commit .env or fieldkit.env.
NVIDIA_API_KEY=
AUTO_ONTOLOGY_SOURCE=/absolute/path/to/NVIDIA/auto-ontology
FIELDKIT_AO_PROJECT=fieldkit-auto-ontology
FIELDKIT_AO_PORT=18760
FIELDKIT_AO_UID=1000
FIELDKIT_AO_GID=1000
FIELDKIT_AO_PLATFORM=linux/amd64
FIELDKIT_AO_SETUP_TIMEOUT=1800
FIELDKIT_PROJECTION_DIR=/absolute/path/to/fieldkit/integrations/auto-ontology/data

POSTGRES_USER=fieldkit
POSTGRES_PASSWORD=change-me-generated-by-setup
POSTGRES_DATABASE=auto_ontology
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
AUTH_SECRET=change-me-generated-by-setup
AUTO_ONTOLOGY_ADMIN_EMAIL=admin@fieldkit.local
AUTO_ONTOLOGY_ADMIN_PASSWORD=change-me-generated-by-setup
APP_URL=http://127.0.0.1:18760
AUTO_ONTOLOGY_MCP_PUBLIC_URL=http://127.0.0.1:18763
PYTHON_API_URL=http://auto-ontology:3001
INGESTION_SERVICE_URL=http://ingestion-service:3002
CONNECTION_STRINGS=sqlite:////fieldkit/fieldkit.sqlite

# Model roles inherit NVIDIA_API_KEY through upstream's supported fallback.
# Replace these endpoint/model pairs if using your own compatible deployment.
DEFAULT_MODELS_ENDPOINT=https://integrate.api.nvidia.com/v1
DEFAULT_MODELS_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
EMBED_ENDPOINT=https://integrate.api.nvidia.com/v1
EMBED_MODEL=nvidia/nemotron-3.5-embed-1b
RERANK_ENDPOINT=https://ai.api.nvidia.com/v1/retrieval/nvidia/nemotron-3.5-rerank-8b/reranking
RERANK_MODEL=nvidia/nemotron-3.5-rerank-8b
INGEST_INTERVAL_HOURS=24
LLM_MAX_INFLIGHT=2
LLM_INVOKE_TIMEOUT_S=120
INTERACTIVE=false
# Predictive-table uploads are intentionally unconfigured.
